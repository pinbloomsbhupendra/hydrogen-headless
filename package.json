{
  "name": "hydrogen-storefront",
  "private": true,
  "version": "2025.10.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen --port 4000",
    "preview": "shopify hydrogen preview --build",
    "start": "shopify hydrogen start",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "codegen": "shopify hydrogen codegen",
    "share": "cloudflared tunnel --url https://localhost:4000 --no-tls-verify",
    "share:domain": "npx localtunnel --port 4000 --subdomain prolock-demo-hemant",
    "share:serveo": "ssh -R prolock-demo-hemant:80:localhost:4000 serveo.net",
    "share:ngrok": "ngrok http 4000",
    "hs": "hs",
    "hs:init": "hs init"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "^2025.10.0",
    "@shopify/mini-oxygen": "^4.0.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.12.0",
    "react-router-dom": "7.12.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@hubspot/cli": "^8.0.0",
    "@shopify/cli": "3.85.4",
    "@react-router/dev": "7.12.0",
    "@react-router/fs-routes": "7.12.0",
    "@shopify/hydrogen-codegen": "^0.3.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.2.0",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.2.7",
    "@types/trusted-types": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "mkcert": "^3.2.0",
    "ngrok": "^5.0.0-beta.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^6.2.4",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults"
  ]
}